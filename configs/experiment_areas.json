    "deployment_objectives": {"runner": "experiments/deployment_objective_analysis.py", "config": "configs/mechanisms/deployment_objectives.json"},
    "peer_exchange_subset_degree_and_provenance": {"runner_dir": "analysis", "evidence_dir": "artifacts/raw/mechanisms"},
