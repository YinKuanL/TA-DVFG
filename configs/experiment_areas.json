    "k_sensitivity": {"runner": "experiments/run_k_sensitivity.py", "config": "configs/robustness/k_sensitivity.json"},
    "nested_weak_scaling": {"runner": "experiments/run_nested_weak_scaling.py", "config": "configs/robustness/nested_weak_scaling.json"},
    "label_budget": {"runner": "experiments/run_experiments.py", "suite": "validation_label_budget"},
    "topology_update_frequency": {"runner": "experiments/run_experiments.py", "suite": "topology_frequency"},
    "party_scalability": {"runner": "experiments/run_experiments.py", "suite": "party_scalability"},
    "minimum_link_m0": {"runner": "experiments/run_cached_minedges_sweep.py"},
    "edge_budget_and_tau": {"runner": "experiments/run_experiments.py", "suite": "edge_budget"},
    "latent_alignment": {"runner": "experiments/alignment_references.py", "config": "configs/alignment/acm_hard.json", "evidence": "artifacts/raw/alignment_acm_hard"},
    "movielens": {"runner": "experiments/movielens/run_movielens_tadvfg.py", "config": "configs/movielens/defaults.json"}
  }
}
